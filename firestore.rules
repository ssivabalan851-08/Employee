rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isManager() {
      return isSignedIn() && request.auth.token.manager == true;
    }

    function hasOnlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validLeaveType(value) {
      return value in ['annual', 'sick', 'casual', 'parental'];
    }

    function validEmployeeRequestCreate() {
      return isOwner(request.resource.data.uid) &&
        request.resource.data.employeeId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        validLeaveType(request.resource.data.leaveType) &&
        request.resource.data.totalDays is int &&
        request.resource.data.totalDays > 0 &&
        request.resource.data.duration == request.resource.data.totalDays &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 3 &&
        request.resource.data.reason.size() <= 1000;
    }

    function validEmployeeRequestUpdate() {
      return isOwner(resource.data.uid) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.employeeId == resource.data.employeeId &&
        (
          (resource.data.status == 'pending' &&
            request.resource.data.status in ['cancelled', 'withdrawn'] &&
            hasOnlyChanged(['status', 'updatedAt', 'cancelledAt', 'cancellationReason'])) ||
          (resource.data.status == 'approved' &&
            request.resource.data.status == 'cancellation_pending' &&
            hasOnlyChanged(['status', 'updatedAt', 'cancellationRequestedAt', 'cancellationReason']))
        );
    }

    // Users Collection Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isManager();
      allow create: if isSignedIn() && isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email is string &&
        request.resource.data.role == 'employee';
      allow update: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        hasOnlyChanged(['name', 'department', 'title']);
      allow delete: if false;
    }

    // Leave Balances Rules
    match /leave_balances/{balanceId} {
      allow read: if isSignedIn() && (isOwner(balanceId) || isManager());
      allow create: if isOwner(balanceId) &&
        request.resource.data.uid == balanceId &&
        request.resource.data.annual == { total: 20, used: 0 } &&
        request.resource.data.sick == { total: 10, used: 0 } &&
        request.resource.data.casual == { total: 7, used: 0 } &&
        request.resource.data.parental == { total: 30, used: 0 };
      allow update: if isManager() &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Leave Requests Rules
    match /leave_requests/{requestId} {
      allow read: if isSignedIn() && (isOwner(resource.data.uid) || isManager());
      allow create: if isSignedIn() && validEmployeeRequestCreate();
      allow update: if isSignedIn() && (isManager() || validEmployeeRequestUpdate());
      allow delete: if false;
    }

    // Audit Logs Rules
    match /audit_logs/{logId} {
      allow read: if isSignedIn() &&
        (resource.data.employeeId == request.auth.uid || isManager());
      allow create: if isSignedIn() &&
        request.resource.data.actorId == request.auth.uid &&
        (request.resource.data.employeeId == request.auth.uid || isManager());
      allow update, delete: if false;
    }

    // Notifications Rules
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isOwner(resource.data.uid);
      allow create: if isSignedIn() &&
        (request.resource.data.uid == request.auth.uid || isManager());
      allow update: if isSignedIn() && isOwner(resource.data.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isSignedIn() && isOwner(resource.data.uid);
    }
  }
}

