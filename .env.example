# Public browser connection values from Supabase Project Settings > API.
# The publishable/anon key is safe to expose only because every table uses RLS.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Set to true only after the Google provider is configured in Supabase.
VITE_ENABLE_GOOGLE_AUTH="false"
