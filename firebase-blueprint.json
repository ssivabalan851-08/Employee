{
  "entities": {
    "User": {
      "title": "User",
      "description": "Enterprise employee or manager profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase authentication UID" },
        "email": { "type": "string", "format": "email", "description": "Corporate email address" },
        "name": { "type": "string", "description": "Employee's full name" },
        "role": { "type": "string", "enum": ["employee", "manager"], "description": "Access control role" },
        "department": { "type": "string", "description": "Enterprise department" },
        "title": { "type": "string", "description": "Job title" },
        "joinedDate": { "type": "string", "description": "YYYY-MM-DD date of joining" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role"]
    },
    "LeaveBalance": {
      "title": "LeaveBalance",
      "description": "Accrued and used leave balances for an employee",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Reference to the User uid" },
        "annual": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "used": { "type": "integer" }
          }
        },
        "sick": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "used": { "type": "integer" }
          }
        },
        "casual": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "used": { "type": "integer" }
          }
        },
        "parental": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "used": { "type": "integer" }
          }
        }
      },
      "required": ["uid"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Leave application form details and workflow status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "uid": { "type": "string", "description": "Applicant User ID" },
        "employeeName": { "type": "string" },
        "employeeEmail": { "type": "string" },
        "leaveType": { "type": "string", "enum": ["annual", "sick", "casual", "parental"] },
        "startDate": { "type": "string", "description": "YYYY-MM-DD" },
        "endDate": { "type": "string", "description": "YYYY-MM-DD" },
        "totalDays": { "type": "integer" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancellation_pending", "cancelled", "withdrawn"] },
        "employeeId": { "type": "string", "description": "Canonical applicant User ID" },
        "duration": { "type": "integer", "description": "Business-day duration" },
        "applicationDate": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "cancellationRequestedAt": { "type": "string", "format": "date-time" },
        "cancellationReason": { "type": "string" },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "rejectedAt": { "type": "string", "format": "date-time" },
        "managerComment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "processedAt": { "type": "string", "format": "date-time" },
        "processedBy": { "type": "string", "description": "UID of the processing manager" }
      },
      "required": ["uid", "employeeId", "leaveType", "startDate", "endDate", "duration", "totalDays", "status", "applicationDate", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app system notifications for employees regarding leave workflow status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string", "description": "Target User UID" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["unread", "read"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "title", "message", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only leave workflow event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "leaveId": { "type": "string" },
        "employeeId": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string", "enum": ["employee", "hr"] },
        "action": { "type": "string", "enum": ["leave_submitted", "leave_approved", "leave_rejected", "leave_cancellation_requested", "leave_cancelled"] },
        "previousStatus": { "type": "string" },
        "newStatus": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "leaveId", "actorId", "actorRole", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/leave_balances/{balanceId}": {
      "schema": "LeaveBalance",
      "description": "Employee leave balances mapped by user uid"
    },
    "/leave_requests/{requestId}": {
      "schema": "LeaveRequest",
      "description": "Leave request records"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "In-app notifications"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only workflow history"
    }
  }
}

